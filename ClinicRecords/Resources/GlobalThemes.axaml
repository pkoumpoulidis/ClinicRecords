<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- LIGHT THEME -->
        <ResourceDictionary x:Key="Light">

            <!-- Base brushes -->
            <SolidColorBrush x:Key="Brush.Background" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Brush.Surface" Color="#FFF8FAFC" />
            <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FFF1F5F9" />
            <SolidColorBrush x:Key="Brush.Border" Color="#FFE2E8F0" />
            
            <SolidColorBrush x:Key="Brush.ForegroundSpecial" Color="#FFF8FAFC"/>

            <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FF0F172A" />
            <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF475569" />
            <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF94A3B8" />

            <!-- Status foreground brushes -->
            <SolidColorBrush x:Key="Brush.StatusInfo" Color="#FF2563EB" />
            <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF16A34A" />
            <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFD97706" />
            <SolidColorBrush x:Key="Brush.StatusError" Color="#FFDC2626" />

            <!-- Status background brushes -->
            <SolidColorBrush x:Key="Brush.StatusInfoBackground" Color="#FFDBEAFE" />
            <SolidColorBrush x:Key="Brush.StatusSuccessBackground" Color="#FFDCFCE7" />
            <SolidColorBrush x:Key="Brush.StatusWarningBackground" Color="#FFFEF3C7" />
            <SolidColorBrush x:Key="Brush.StatusErrorBackground" Color="#FFFEE2E2" />

            <!-- Status border brushes -->
            <SolidColorBrush x:Key="Brush.StatusInfoBorder" Color="#FF93C5FD" />
            <SolidColorBrush x:Key="Brush.StatusSuccessBorder" Color="#FF86EFAC" />
            <SolidColorBrush x:Key="Brush.StatusWarningBorder" Color="#FFFCD34D" />
            <SolidColorBrush x:Key="Brush.StatusErrorBorder" Color="#FFFCA5A5" />

        </ResourceDictionary>


        <!-- DARK THEME -->
        <ResourceDictionary x:Key="Dark">

            <!-- Base brushes -->
            <SolidColorBrush x:Key="Brush.Background" Color="#FF0F172A" />
            <SolidColorBrush x:Key="Brush.Surface" Color="#FF1E293B" />
            <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF334155" />
            <SolidColorBrush x:Key="Brush.Border" Color="#FF475569" />

            <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFF8FAFC" />
            <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFCBD5E1" />
            <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF94A3B8" />

            <!-- Status foreground brushes -->
            <SolidColorBrush x:Key="Brush.StatusInfo" Color="#FF60A5FA" />
            <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF4ADE80" />
            <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFFBBF24" />
            <SolidColorBrush x:Key="Brush.StatusError" Color="#FFF87171" />

            <!-- Status background brushes -->
            <SolidColorBrush x:Key="Brush.StatusInfoBackground" Color="#FF172554" />
            <SolidColorBrush x:Key="Brush.StatusSuccessBackground" Color="#FF052E16" />
            <SolidColorBrush x:Key="Brush.StatusWarningBackground" Color="#FF422006" />
            <SolidColorBrush x:Key="Brush.StatusErrorBackground" Color="#FF450A0A" />

            <!-- Status border brushes -->
            <SolidColorBrush x:Key="Brush.StatusInfoBorder" Color="#FF1D4ED8" />
            <SolidColorBrush x:Key="Brush.StatusSuccessBorder" Color="#FF15803D" />
            <SolidColorBrush x:Key="Brush.StatusWarningBorder" Color="#FFB45309" />
            <SolidColorBrush x:Key="Brush.StatusErrorBorder" Color="#FFB91C1C" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>